# ---- dependencies ----------------------------------------------------------
node_modules/
.pnp/
.pnp.*

# ---- build output ----------------------------------------------------------
dist/
dist-ssr/
build/
*.tsbuildinfo

# ---- generated at install/dev time -----------------------------------------
# pdf.js ships CMaps, standard font data, ICC profiles and wasm decoders that
# it fetches over HTTP at runtime. `npm run assets` copies them out of
# node_modules; they are a build artifact, not source.
public/pdfjs/

# Scratch output: `npm run render-check` writes before/after comparisons here.
tmp/

# ---- test fixtures that embed a system font --------------------------------
# Every other fixture is a hand-written PDF of about a kilobyte and is checked
# in, because the test suite reads them directly. These two are different:
# `npm run fixtures` embeds whatever TrueType file it finds on the machine
# (Arial, on a Mac), which makes them ~760 KB each, non-deterministic across
# machines, and a redistribution of a font that is not ours to redistribute.
# Regenerate them locally with `npm run fixtures`; the tests that need them
# skip cleanly when they are absent.
fixtures/embedded-truetype.pdf
fixtures/type0-identity-h.pdf

# Vercel's local project link (contains project/org ids).
.vercel

